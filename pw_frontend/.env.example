# Local dev only — copy to `.env` and fill in values.
# Never commit `.env` or put secrets in frontend source files.

RESEND_API_KEY=re_your_send_only_key_here
CONTACT_TO_EMAIL=your_email@example.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

## Optional: override Deck of Cards API base URL
## Default: https://deckofcardsapi.com
VITE_DECK_API_BASE=https://deckofcardsapi.com
